---
type Props = {
  title: string; // "Bluebook"
};

const { title } = Astro.props;
---

{/* A row of numbers from one source, with where they're from (the "detail" slot) on the right. */}
<div class="flex flex-col gap-1.5">
  <div class="flex items-baseline justify-between gap-2 text-xs">
    <span class="font-semibold uppercase tracking-wide text-zinc-400">{title}</span>
    <span class="text-right text-zinc-500"><slot name="detail" /></span>
  </div>
  <div class="grid auto-cols-fr grid-flow-col gap-2"><slot /></div>
</div>
