---
type Frame = {
  label: string; // the tab: "Without RowdySearch"
  image: string; // "/extension/planner-without.webp"
  description: string; // what the screenshot shows, for screen readers
};

type Props = {
  name: string; // unique on the page: "planner"
  frames: [Frame, Frame, Frame];
  width: number; // the screenshots' size in pixels, so the page doesn't jump as they load
  height: number;
};

const { name, frames, width, height } = Astro.props;
// The last frame (the sidebar open) shows first. Flipping back to the first is the comparison.
const shownFirst = frames.length - 1;
---

{/* Three screenshots of the same page, one shown at a time. The tabs are radio buttons, so
    switching needs no JavaScript and works with the keyboard's arrow keys. */}
<div class="before-after flex flex-col gap-3">
  {frames.map((frame, number) => (
    <input type="radio" name={name} id={`${name}-${number}`} checked={number === shownFirst} class="sr-only" />
  ))}

  <div class="tabs flex flex-wrap gap-2" role="presentation">
    {frames.map((frame, number) => (
      <label for={`${name}-${number}`} class="cursor-pointer rounded-lg bg-zinc-800 px-3 py-1.5 text-sm text-zinc-300 transition-colors hover:bg-zinc-700">
        {frame.label}
      </label>
    ))}
  </div>

  <div class="frames overflow-hidden rounded-xl ring-1 ring-zinc-700">
    {frames.map((frame) => (
      <img src={frame.image} alt={frame.description} width={width} height={height} decoding="async" class="h-auto w-full" />
    ))}
  </div>
</div>

<style>
  .frames img {
    display: none;
  }

  input:nth-of-type(1):checked ~ .frames img:nth-of-type(1),
  input:nth-of-type(2):checked ~ .frames img:nth-of-type(2),
  input:nth-of-type(3):checked ~ .frames img:nth-of-type(3) {
    display: block;
  }

  input:nth-of-type(1):checked ~ .tabs label:nth-of-type(1),
  input:nth-of-type(2):checked ~ .tabs label:nth-of-type(2),
  input:nth-of-type(3):checked ~ .tabs label:nth-of-type(3) {
    background-color: var(--color-orange-600);
    color: var(--color-zinc-100);
  }

  input:nth-of-type(1):focus-visible ~ .tabs label:nth-of-type(1),
  input:nth-of-type(2):focus-visible ~ .tabs label:nth-of-type(2),
  input:nth-of-type(3):focus-visible ~ .tabs label:nth-of-type(3) {
    outline: 2px solid var(--color-orange-300);
    outline-offset: 2px;
  }
</style>
