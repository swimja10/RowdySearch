---
type Props = {
  label: string;
  value: string;
  note?: string; // a second, smaller line: the same number for the whole course
};

const { label, value, note } = Astro.props;
---

<div class="flex flex-col rounded-xl bg-zinc-800 p-3">
  <span class="text-xs text-zinc-400">{label}</span>
  <span class="text-lg font-semibold">{value}</span>
  {note && <span class="text-xs text-zinc-500">{note}</span>}
</div>
