---
import {
  FINISHED_OR_WITHDREW,
  GRADES,
  countStudents,
  formatShare,
  gradeShares,
  type GradeCounts,
} from "../data/shared.ts";

type Props = {
  grades: GradeCounts;
};

const { grades } = Astro.props;
const shares = gradeShares(grades);
// The most common grade gets a full-height bar so the bars are easy to compare.
const tallestPercent = Math.max(...shares.map((share) => share.percent));
const total = countStudents(grades, FINISHED_OR_WITHDREW);

// Every grade anyone got, for the table under the bars. Incompletes aren't part of the percentages.
const rows = GRADES.filter((grade) => grades[grade] > 0).map((grade) => ({
  grade,
  students: grades[grade],
  percent: FINISHED_OR_WITHDREW.includes(grade) ? formatShare((grades[grade] / total) * 100) : "—",
}));
---

{tallestPercent === 0 ? (
  <p class="text-sm text-zinc-500">No grades have been released yet.</p>
) : (
  <div class="flex flex-col gap-2 rounded-xl bg-zinc-800 p-3">
    <div class="flex gap-2">
      {shares.map((share) => (
        <div class="flex flex-1 flex-col items-center gap-1">
          <span class="text-xs text-zinc-400">{formatShare(share.percent)}</span>
          <div class="flex h-16 w-full items-end rounded bg-zinc-700">
            <div class="w-full rounded bg-orange-500" style={`height: ${(share.percent / tallestPercent) * 100}%`} />
          </div>
          <span class="text-sm font-medium">{share.label}</span>
        </div>
      ))}
    </div>
    <span class="text-xs text-zinc-400">Based on {total.toLocaleString("en-US")} grades</span>

    {/* The same numbers as text, one row per grade. It's in the page even while it's closed. */}
    <details class="text-sm">
      <summary class="cursor-pointer text-orange-400 hover:text-orange-300">Every grade</summary>
      <table class="mt-2 w-full text-left tabular-nums">
        <thead>
          <tr class="text-xs text-zinc-400">
            <th class="py-1 font-medium">Grade</th>
            <th class="py-1 text-right font-medium">Students</th>
            <th class="py-1 text-right font-medium">Percent</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class="border-t border-zinc-700">
              <td class="py-1">{row.grade}</td>
              <td class="py-1 text-right">{row.students.toLocaleString("en-US")}</td>
              <td class="py-1 text-right">{row.percent}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="mt-2 text-xs text-zinc-500">
        Percentages are out of everyone who got a letter grade or withdrew (W). IN, IW, and IF are incompletes.
      </p>
    </details>
  </div>
)}
