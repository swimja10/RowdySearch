---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { PREVIEW_IMAGE, PREVIEW_IMAGE_SAYS, SITE_NAME, SITE_URL } from "../data/site.ts";

type Props = {
  title: string; // what the page is, without the site's name
  description: string; // one or two sentences, shown under the title in search results
  isHome?: boolean; // the home page has its own big search box, so the header leaves its one out
  isWide?: boolean; // Analytical Mode's charts and table use the whole width of a big screen
  isHidden?: boolean; // search engines leave the page out (the "page not found" page)
};

const { title, description, isHome = false, isWide = false, isHidden = false } = Astro.props;
const fullTitle = isHome ? title : `${title} | ${SITE_NAME}`;
const address = new URL(Astro.url.pathname, SITE_URL).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={address} />
    {isHidden && <meta name="robots" content="noindex" />}
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/icon-32.png" />
    <link rel="apple-touch-icon" href="/icons/icon-128.png" />
    <meta name="theme-color" content="#18181b" />
    {/* Marks the page as having JavaScript before anything is drawn. The styles use it to show long lists a page at a time. */}
    <script is:inline>document.documentElement.classList.add("js");</script>

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={address} />
    <meta property="og:locale" content="en_US" />
    {/* The picture and the big-picture layout for links sent in GroupMe, Discord, iMessage, and X. */}
    <meta property="og:image" content={PREVIEW_IMAGE} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={PREVIEW_IMAGE_SAYS} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="flex min-h-screen flex-col bg-zinc-900">
    <Header showSearch={!isHome} />
    <main class:list={["mx-auto w-full flex-1 px-4 py-8 sm:py-10", isWide ? "max-w-[100rem]" : "max-w-6xl"]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
