{
  "name": "rowdysearch-site",
  "private": true,
  "type": "module",
  "scripts": {
    "slugs": "node scripts/update-slugs.mjs",
    "predev": "node scripts/update-slugs.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/update-slugs.mjs",
    "build": "astro build",
    "postbuild": "node scripts/check-site.mjs",
    "check": "node scripts/check-site.mjs",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy && node scripts/indexnow.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "screenshots": "node scripts/prepare-screenshots.mjs",
    "test:search": "node --test ../tests/site_search.test.ts",
    "test:compare": "node --test ../tests/site_compare.test.ts",
    "test:indexnow": "node --test ../tests/site_indexnow.test.ts"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "plotly.js-cartesian-dist-min": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "wrangler": "^4.164.0"
